# Bu dosyayı .env olarak kopyalayıp kendi değerlerinle doldur.
# .env dosyası .gitignore ile takip dışıdır, gerçek değerler asla commit edilmez.

# Solver seçimi: highs (varsayılan, ücretsiz) | gurobi (opsiyonel, lisans gerektirir)
SOLVER=highs

# Database (başlangıçta SQLite, gerektiğinde PostgreSQL connection string ile değiştirilir)
DATABASE_URL=sqlite:///./data/factory.db

# Dataset boyutu: small | medium | large
DATASET_SIZE=small

# Synthetic data generator için deterministik seed
RANDOM_SEED=42

# Backend
API_HOST=127.0.0.1
API_PORT=8000
